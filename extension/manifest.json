{
  "manifest_version": 3,
  "name": "VeilAgent",
  "version": "0.1.0",
  "description": "Privacy-first browser agent: sees a page locally, redacts sensitive data before anything leaves the device, then acts on the page.",
  "permissions": ["activeTab", "tabs", "scripting", "storage", "sidePanel"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open VeilAgent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
      "js": [
        "detection/piiDetector.js",
        "redaction/redactor.js",
        "content/domExtractor.js",
        "content/executor.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
